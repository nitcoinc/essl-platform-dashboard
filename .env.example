# Copy to .env (deploy/install.sh does this with mode 600) and fill in.
# .env is gitignored -- never commit real secrets.
# Required values carry a '# REQUIRED' line above them; everything else has a working default.

# --- Data folder ------------------------------------------------------------
# Absolute host path for the database folder (essl.db, its -wal, backup
# status). Native Linux filesystem only (no NFS/SMB). Empty = Docker volume
# essl-data. deploy/install.sh sets owner 10001:10001 and mode 700.
ESSL_DATA_DIR=

# --- Backups to Cloudflare R2 ------------------------------------------------
# The backup service snapshots the database every ESSL_BACKUP_MINUTES to
# recent/, keeps one nightly/ copy per day, and prunes both. No URL needed:
# endpoint is built from R2_ACCOUNT_ID. One R2 API token, Object Read & Write,
# scoped to this bucket only. README "Backups".
# REQUIRED
R2_ACCOUNT_ID=
# REQUIRED
R2_BUCKET=
# REQUIRED
R2_EXPORT_ACCESS_KEY_ID=
# REQUIRED
R2_EXPORT_SECRET_ACCESS_KEY=
ESSL_BACKUP_MINUTES=15
# Keep recent/ snapshots this many hours, nightly/ copies this many days.
ESSL_BACKUP_KEEP_HOURS=48
ESSL_BACKUP_KEEP_DAYS=30
# Hour of day (0-23, IST) from which the day's nightly/ copy is taken.
ESSL_EXPORT_HOUR=2

# --- Upgrading from Turso (one-time) ---------------------------------------
# Only for `docker compose run --rm backup python -m essl_hub.backup import-turso`.
# Clear both after a week of clean backups.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Reaching the dashboard ----------------------------------------------
# The web app listens on 127.0.0.1:ESSL_WEB_PORT on the host. If the host
# already runs cloudflared, route your public hostname to http://localhost:8080.
ESSL_WEB_PORT=8080
# 127.0.0.1 = this host only. 0.0.0.0 = also http://<server-ip>:8080 on the
# LAN; then set ESSL_FORCE_HTTPS_COOKIES=false (plain http) and accept that
# LAN users can fake CF-Connecting-IP (README "LAN access").
ESSL_WEB_BIND=127.0.0.1
# OPTIONAL bundled tunnel instead: set the token AND COMPOSE_PROFILES=tunnel,
# then route the public hostname to http://web:8000.
TUNNEL_TOKEN=
COMPOSE_PROFILES=

# --- Collector (polls the devices on the office network) -------------------
# Poll interval; the admin screen also uses it to say when an edit applies.
ESSL_COLLECTOR_INTERVAL_SECONDS=60
# Write the device row at least this often even when nothing changed (KTD11).
ESSL_HEARTBEAT_WRITE_SECONDS=900
# Device IPs below only seed the first two devices on first boot. After that the
# devices table wins: add, edit, retire or re-enable devices on the Devices page.
ESSL_X990_IP=192.168.1.201
ESSL_X990_PORT=4370
ESSL_X990_PASSWORD=0
ESSL_C3_IP=192.168.1.202
ESSL_C3_PORT=4370
ESSL_C3_PASSWORD=
# auto: full history download at start and every ESSL_C3_HISTORY_HOURS, live queue in between.
ESSL_C3_MODE=auto
ESSL_C3_HISTORY_HOURS=6
ESSL_C3_RTLOG_BATCH=250
# C3 PINs map to the X990 IDs (9 -> NP0009); shared cards stay unlinked as C3-<pin>.
ESSL_C3_ID_FORMAT=NP{pin:04d}
ESSL_C3_UNLINKED_PINS=1,2

# --- Sign-in email (one provider REQUIRED) ---------------------------------
# Default: Cloudflare Email Service (sending domain must use Cloudflare DNS).
# Fallback: Resend. With both configured, Cloudflare wins unless
# ESSL_MAIL_PROVIDER says otherwise (cloudflare|resend). `console` prints codes to the log: local testing only, never production.
ESSL_MAIL_PROVIDER=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_FROM_ADDRESS=attendance@yourcompany.com
RESEND_API_KEY=
RESEND_FROM_ADDRESS=attendance@yourcompany.com

# --- Bot protection (Cloudflare Turnstile) ---------------------------------
# Recommended for production. Both set = sign-in and setup forms require the
# Turnstile check; unset = no check (local testing). README "Protection".
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Dashboard -------------------------------------------------------------
# Secure cookies; keep true behind the tunnel (HTTPS at Cloudflare).
ESSL_FORCE_HTTPS_COOKIES=true
# HTTP cap on a roster upload, in megabytes.
ESSL_MAX_UPLOAD_MB=5

# First-run admin setup, needed only until one admin exists:
#  1. ESSL_SETUP_TOKEN (16+ chars) enables a one-time /setup page.
#  2. ESSL_BOOTSTRAP_ADMIN_EMAIL promotes that roster row to admin.
ESSL_SETUP_TOKEN=
ESSL_BOOTSTRAP_ADMIN_EMAIL=

# Frappe HR (HRMS v15/v16) push. All three set = enabled.
FRAPPE_URL=                      # e.g. https://hr.example.com
FRAPPE_API_KEY=                  # API key of a Frappe user with Employee Checkin create + Shift Type write
FRAPPE_API_SECRET=
FRAPPE_SYNC_INTERVAL_SECONDS=60
FRAPPE_SYNC_BATCH_SIZE=200
FRAPPE_EMPLOYEE_FIELDNAME=attendance_device_id   # or "employee" / "name"
FRAPPE_SHIFT_TYPES=              # comma list, e.g. "General,Night"; updates last_sync_of_checkin
FRAPPE_SYNC_SINCE=               # optional local datetime, e.g. 2026-10-01T00:00:00; older punches never pushed
